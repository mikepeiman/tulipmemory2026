---
import Base from '../../layouts/Base.astro';
import { families, contact } from '../../data/site.js';

export function getStaticPaths() {
  return families.map((f) => ({ params: { series: f.slug }, props: { f } }));
}
const { f } = Astro.props;

const title = `${f.name} Memory Upgrade (FANRAM) | Tulip Electronics`;
const partsText = f.oemParts.length ? ` Replaces ${f.oemParts.join(', ')}.` : '';
const description = `New FANRAM memory board for ${f.name} CNC controls — ${f.caps}.${partsText} 3-year warranty, made in Canada since 1984.`;

const faqs = [
  {
    q: `Will a FANRAM board work on my ${f.name} control?`,
    a: `Yes — FANRAM boards are purpose-built for ${f.name} controls${f.sub ? ` (${f.sub})` : ''}. ${f.replaces !== 'OEM RAM' ? `They replace the ${f.replaces}.` : 'They replace the original OEM memory.'} If you're unsure of your exact configuration, call ${contact.phone} and we'll confirm the fit before you order.`
  },
  {
    q: 'Do I need to back up parameters before installing?',
    a: 'A step-by-step install manual is included with every board. Where the control supports it, the autoload procedure transfers parameters and programs from the original board; otherwise the manual walks you through re-entering them. Phone support is free if you get stuck.'
  },
  {
    q: 'Is this a new board or refurbished?',
    a: 'New manufacture. Every FANRAM board is designed and built by Tulip Electronics in Kitchener, Ontario, Canada — the original manufacturer of the FANRAM line — and carries a 3-year warranty. Customers still run FANRAM boards shipped in the 1990s.'
  }
];

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `FANRAM Memory Board for ${f.name}`,
  image: new URL(f.img, Astro.site).href,
  description,
  brand: { '@type': 'Brand', name: 'Tulip Electronics' },
  manufacturer: { '@id': 'https://tulipmemory.com/#org' },
  additionalProperty: f.oemParts.map((p) => ({ '@type': 'PropertyValue', name: 'Replaces OEM part', value: p })),
  offers: { '@type': 'Offer', availability: 'https://schema.org/InStock', url: new URL(Astro.url.pathname, Astro.site).href, priceCurrency: 'USD' }
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((x) => ({ '@type': 'Question', name: x.q, acceptedAnswer: { '@type': 'Answer', text: x.a } }))
};
---

<Base
  title={title}
  description={description}
  ogImage={f.img}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Fanuc memory upgrades', path: '/fanuc-memory-upgrades/' },
    { name: f.name, path: `/fanuc-memory-upgrades/${f.slug}/` }
  ]}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="container" style="padding-top:36px;padding-bottom:56px">
    <nav class="mono" style="font-size:12px;color:var(--tx3);margin-bottom:22px" aria-label="Breadcrumb">
      <a href="/">HOME</a> / <a href="/fanuc-memory-upgrades/">MEMORY BOARDS</a> / {f.name.toUpperCase()}
    </nav>

    <div class="hero-grid" style="display:grid;grid-template-columns:460px 1fr;gap:44px;align-items:start">
      <div class="card" style="overflow:hidden;box-shadow:var(--shadow)">
        <img src={f.img} alt={`FANRAM memory board for ${f.name}${f.oemParts.length ? `, replacement for ${f.oemParts.join(' and ')}` : ''}`} style="width:100%;height:300px;object-fit:cover;display:block" />
        <p class="mono" style="padding:14px 18px;font-size:11.5px;color:var(--tx3);margin:0">PHOTOGRAPHED ON OUR BENCH · NEW MANUFACTURE, NOT REFURBISHED</p>
      </div>

      <div style="display:flex;flex-direction:column;gap:16px">
        <p class="eyebrow" style="margin:0">FANRAM MEMORY BOARD</p>
        <h1 style="font:700 36px/1.1 'Public Sans',sans-serif;margin:0">{f.name} memory upgrade <span style="font:400 20px 'Public Sans',sans-serif;color:var(--tx3)">{f.sub}</span></h1>
        <p style="font:400 15px/1.6 'Public Sans',sans-serif;color:var(--tx2);margin:0">{f.desc}</p>
        {f.oemParts.length > 0 && (
          <p style="font:400 14px/1.6 'Public Sans',sans-serif;color:var(--tx2);margin:0">Direct replacement for Fanuc part numbers <b style="color:var(--tx)">{f.oemParts.join(' and ')}</b>.</p>
        )}

        <div>
          <p class="microlabel" style="margin:0 0 8px">AVAILABLE CAPACITIES</p>
          <div style="display:flex;gap:8px;flex-wrap:wrap">
            {f.capList.map((c) => (
              <span class="mono" style="padding:9px 16px;border:1px solid var(--btn2line);border-radius:6px;font-size:13px;font-weight:600">{c}</span>
            ))}
          </div>
        </div>

        <div class="card" style="border-radius:8px;overflow:hidden">
          <dl style="display:grid;grid-template-columns:150px 1fr;gap:0;font:400 13px 'Public Sans',sans-serif;margin:0">
            <dt class="mono" style="padding:11px 16px;border-bottom:1px solid var(--line);color:var(--tx3);font-size:11px;letter-spacing:0.08em">REPLACES</dt>
            <dd style="padding:11px 16px;border-bottom:1px solid var(--line);margin:0">{f.replaces}</dd>
            <dt class="mono" style="padding:11px 16px;border-bottom:1px solid var(--line);color:var(--tx3);font-size:11px;letter-spacing:0.08em">INSTALL</dt>
            <dd style="padding:11px 16px;border-bottom:1px solid var(--line);margin:0">Step-by-step manual included. Autoload transfers parameters and programs from the original board where the control supports it.</dd>
            <dt class="mono" style="padding:11px 16px;border-bottom:1px solid var(--line);color:var(--tx3);font-size:11px;letter-spacing:0.08em">WARRANTY</dt>
            <dd style="padding:11px 16px;border-bottom:1px solid var(--line);margin:0">3 years, backed by the builder — <a href="/warranty/">terms</a></dd>
            <dt class="mono" style="padding:11px 16px;color:var(--tx3);font-size:11px;letter-spacing:0.08em">ORIGIN</dt>
            <dd style="padding:11px 16px;margin:0">Designed &amp; built in Kitchener, Ontario, Canada</dd>
          </dl>
        </div>

        <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap">
          <!-- TODO:STRIPE replace with Stripe Payment Link when prices are set -->
          <a href="/quote/" class="btn">Buy — get price &amp; lead time</a>
          <a href="/quote/" class="btn btn--outline">Ask a question</a>
          <span class="mono" style="font-size:12px;color:var(--tx3)">OR CALL {contact.phone}</span>
        </div>
      </div>
    </div>

    <section style="max-width:760px;margin-top:48px">
      <h2 style="font:700 22px 'Public Sans',sans-serif;margin:0 0 18px">Common questions</h2>
      {faqs.map((x) => (
        <details style="border-bottom:1px solid var(--line);padding:14px 0">
          <summary style="font:700 15px 'Public Sans',sans-serif;cursor:pointer">{x.q}</summary>
          <p style="font:400 14px/1.65 'Public Sans',sans-serif;color:var(--tx2);margin:10px 0 0">{x.a}</p>
        </details>
      ))}
    </section>
  </section>
</Base>

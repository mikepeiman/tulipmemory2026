---
// Per-service pages: /services/retrofit/, /services/service/, etc.
// Each page leads with the specifics of the service the visitor clicked,
// then a shared "one shop, every service" block covering what applies to
// all services, then a CTA that pre-selects the service on the quote form.
import Base from '../../layouts/Base.astro';
import { services, contact } from '../../data/site.js';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service }
  }));
}

const { service } = Astro.props;
const others = services.filter((s) => s.slug !== service.slug);

const title = `${service.name} — Legacy CNC Controls | Tulip Electronics`;
const description = `${service.long} From the engineer who builds FANRAM boards, in ${contact.city}.`;
---

<Base
  title={title}
  description={description}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services/' },
    { name: service.name, path: `/services/${service.slug}/` }
  ]}
>
  <section class="container" style="max-width:900px;padding-top:52px;padding-bottom:26px">
    <p class="eyebrow" style="margin:0 0 14px">{service.tag}</p>
    <h1 style="font:700 34px 'Public Sans',sans-serif;margin:0 0 10px">{service.name}</h1>
    <p style="font:400 16px/1.6 'Public Sans',sans-serif;color:var(--tx2);margin:0;max-width:64ch">{service.intro}</p>
  </section>

  <section class="container" style="max-width:900px;padding-bottom:36px">
    <div class="card" style="padding:26px 30px;display:flex;flex-direction:column;gap:20px">
      {service.points.map((pt) => (
        <div>
          <h2 style="font:700 15px 'Public Sans',sans-serif;margin:0 0 5px">{pt.h}</h2>
          <p style="font:400 14px/1.65 'Public Sans',sans-serif;color:var(--tx2);margin:0">{pt.p}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- General: applies to every service, whichever card the visitor came from -->
  <section class="container" style="max-width:900px;padding-bottom:36px">
    <div style="padding:24px 28px;border:1.5px solid var(--accLine);border-radius:10px;background:var(--accSoft)">
      <h2 style="font:700 16px 'Public Sans',sans-serif;margin:0 0 8px">One shop, every service</h2>
      <p style="font:400 14px/1.65 'Public Sans',sans-serif;color:var(--tx2);margin:0 0 10px">However you engage Tulip — retrofit, service call, support or consultation — it comes from the same small shop in {contact.city}, and from the engineer who designs the boards. No ticket queue, no call centre: you describe the problem to the person most likely to have seen it before.</p>
      <p style="font:400 14px/1.65 'Public Sans',sans-serif;color:var(--tx2);margin:0 0 12px">Every board we sell carries a three-year <a href="/warranty/">warranty</a>, and support for it is free for life. Most enquiries get an answer within one business day.</p>
      <p class="mono" style="font-size:12px;color:var(--tx3);margin:0">{contact.email} · {contact.phone} · MON–FRI 8–5 ET</p>
    </div>
  </section>

  <section class="container" style="max-width:900px;padding-bottom:36px">
    <div style="padding:28px 32px;background:var(--ctaBg);border:1px solid var(--accLine);border-radius:12px;display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap">
      <div>
        <h2 style="font:700 20px 'Public Sans',sans-serif;color:var(--ctaTx);margin:0 0 4px">Tell us about your machine.</h2>
        <p style="font:400 13.5px 'Public Sans',sans-serif;color:var(--ctaSub);margin:0">Prefer to talk? {contact.phone} — we like to talk shop.</p>
      </div>
      <a href={`/quote/?service=${service.slug}`} class="btn" style="white-space:nowrap">Start a conversation</a>
    </div>
  </section>

  <section class="container" style="max-width:900px;padding-bottom:64px">
    <h2 style="font:700 18px 'Public Sans',sans-serif;margin:0 0 14px">All services</h2>
    <div class="grid-3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px">
      {others.map((o) => (
        <a href={`/services/${o.slug}/`} class="card" style="padding:18px 20px;display:block;color:var(--tx)">
          <p class="microlabel" style="color:var(--red);margin:0 0 8px">{o.tag}</p>
          <h3 style="font:700 14px 'Public Sans',sans-serif;margin:0 0 6px">{o.name}</h3>
          <p style="font:400 12.5px/1.5 'Public Sans',sans-serif;color:var(--tx2);margin:0">{o.desc}</p>
        </a>
      ))}
    </div>
  </section>
</Base>

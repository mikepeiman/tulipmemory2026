---
import Base from '../layouts/Base.astro';
import { services, contact } from '../data/site.js';
import { families, platformsByFamily, productsByFamily, formatPrice } from '../data/products';
---

<Base
  title="Fanuc, Yasnac &amp; Mitsubishi CNC Memory Upgrades | Tulip Electronics"
  description="New memory boards for legacy Fanuc, Yasnac and Mitsubishi CNC controls. Made in Canada since 1984. 3-year warranty. Boards from the 1990s still running."
>
  <!-- Hero -->
  <section class="container hero-grid" style="display:grid;grid-template-columns:1fr 420px;gap:48px;align-items:center;padding-top:60px;padding-bottom:40px">
    <div style="display:flex;flex-direction:column;gap:20px">
      <p class="eyebrow" style="margin:0">FORTY YEARS OF KEEPING GOOD MACHINES ALIVE</p>
      <h1 style="font:700 48px/1.08 'Public Sans',sans-serif;letter-spacing:-0.015em;margin:0">Your machine isn't obsolete.<br />Its memory board is.</h1>
      <p style="font:400 16px/1.6 'Public Sans',sans-serif;color:var(--tx2);max-width:52ch;margin:0">New memory boards for legacy Fanuc, Yasnac and Mitsubishi controls — plus retrofits, service and consultation from the people who've built them since 1984. Customers still run boards we shipped in the 1990s.</p>
      <div style="display:flex;gap:12px">
        <a href="/products/" class="btn">Find your board</a>
        <a href="/quote/" class="btn btn--outline">Request a quote</a>
      </div>
      <p class="mono" style="display:flex;gap:24px;font-size:11px;font-weight:500;color:var(--tx3);margin:4px 0 0">
        <span>MADE IN CANADA</span><span>KITCHENER, ONTARIO</span><span>EST. 1984</span>
      </p>
    </div>
    <div class="card" style="overflow:hidden;box-shadow:var(--shadow)">
      <img src="/assets/board-blue.jpg" alt="FANRAM-128k memory board for Fanuc CNC controls" style="width:100%;height:220px;object-fit:cover;display:block" />
      <dl class="mono" style="padding:16px 20px;display:grid;grid-template-columns:1fr 1fr;gap:8px 20px;font-size:12px;color:var(--tx3);margin:0">
        <dt>BOARD</dt><dd style="color:var(--tx);text-align:right;margin:0">FANRAM-128k</dd>
        <dt>CAPACITY</dt><dd style="color:var(--tx);text-align:right;margin:0">128K</dd>
        <dt>PRICE</dt><dd style="color:var(--tx);text-align:right;margin:0">{formatPrice(895)}</dd>
      </dl>
    </div>
  </section>

  <!-- Boards table -->
  <section class="container" style="padding-bottom:44px">
    <div class="card" style="overflow:hidden">
      <div style="display:flex;align-items:center;gap:14px;padding:16px 22px;border-bottom:1px solid var(--line);background:var(--bg3);flex-wrap:wrap">
        <h2 style="font:700 13px 'Public Sans',sans-serif;color:var(--acc);margin:0">Memory boards by control family</h2>
        <span style="font:400 12px 'Public Sans',sans-serif;color:var(--tx3)">New manufacture — not refurbished. Model not listed? We can likely still help.</span>
      </div>
      <div class="mono" style="display:grid;grid-template-columns:1.2fr 2fr 1fr auto;gap:0 20px;align-items:center;padding:13px 22px;border-bottom:1px solid var(--line);font-size:10.5px;font-weight:600;letter-spacing:0.1em;color:var(--tx3)">
        <span>CONTROL FAMILY</span><span>CONTROLS SERVED</span><span>BOARDS</span><span style="width:88px"></span>
      </div>
      {families.map((f) => {
        const skus = productsByFamily(f.id);
        const controlList = [...new Set(platformsByFamily(f.id).flatMap((p) => p.controls))].join(', ');
        return (
          <div style="display:grid;grid-template-columns:1.2fr 2fr 1fr auto;gap:0 20px;align-items:center;padding:15px 22px;border-bottom:1px solid var(--line)">
            <span style="font:700 14px 'Public Sans',sans-serif">{f.label}{f.oemLabel && <span style="font:400 12px 'Public Sans',sans-serif;color:var(--tx3)"> ({f.oemLabel})</span>}</span>
            <span class="mono" style="font-size:12px;font-weight:500;color:var(--tx2)">{controlList}</span>
            <span class="mono" style="font-size:12px;color:var(--tx3)">{skus.length} {skus.length === 1 ? 'board' : 'boards'}</span>
            <a href={`/controls/${f.id}/`} class="btn btn--sm" style="width:56px;text-align:center;padding:8px 16px;font-size:12px">View</a>
          </div>
        );
      })}
      <p style="padding:13px 22px;background:var(--bg3);font:400 12px 'Public Sans',sans-serif;color:var(--tx2);margin:0">Not listed? Fanuc 9, 10, 21i-A and others — <a href="/quote/" style="font-weight:700">tell us your control →</a>. Or see <a href="/products/" style="font-weight:700">the full catalogue →</a></p>
    </div>
  </section>

  <!-- Services -->
  <section class="container" style="padding-bottom:44px">
    <h2 style="font:700 24px 'Public Sans',sans-serif;margin:0 0 6px">Beyond the board</h2>
    <p style="font:400 14px 'Public Sans',sans-serif;color:var(--tx2);margin:0 0 18px">Boards are the product. These are the ways we keep your machine running.</p>
    <div class="grid-4" style="display:grid;grid-template-columns:repeat(4,1fr);gap:14px">
      {services.map((s) => (
        <a href="/services/" class="card" style="padding:20px;border-radius:8px;display:block;color:var(--tx)">
          <p class="microlabel" style="color:var(--red);margin:0 0 8px">{s.tag}</p>
          <h3 style="font:700 14px 'Public Sans',sans-serif;margin:0 0 6px">{s.name}</h3>
          <p style="font:400 12.5px/1.5 'Public Sans',sans-serif;color:var(--tx2);margin:0">{s.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- In development -->
  <section class="container" style="padding-bottom:44px">
    <div style="padding:22px 26px;border:1.5px dashed var(--acc);border-radius:10px;background:var(--accSoft);display:flex;align-items:center;gap:24px;flex-wrap:wrap">
      <div style="flex:1;min-width:280px">
        <p class="microlabel" style="color:var(--acc);margin:0 0 6px">IN DEVELOPMENT — SPECULATIVE, RESERVE WITH DEPOSIT</p>
        <h2 style="font:700 17px 'Public Sans',sans-serif;margin:0 0 4px">Fanuc 0 colour-LCD conversion · USB program input</h2>
        <p style="font:400 13px 'Public Sans',sans-serif;color:var(--tx2);margin:0">Demonstrated at IMTS, in active development. A deposit funds the build and holds your place in line.</p>
      </div>
      <a href="/reserve/" class="btn btn--acc-outline" style="white-space:nowrap;padding:11px 20px;font-size:13px">Reserve with deposit</a>
    </div>
  </section>

  <!-- Bill -->
  <section class="container" style="padding-bottom:44px">
    <a href="/about/" class="card" style="display:grid;grid-template-columns:auto 1fr;gap:26px;padding:26px 30px;align-items:center;color:var(--tx)">
      <img src="/assets/bill.jpg" alt="Bill Peiman, founder of Tulip Electronics" style="width:96px;height:96px;object-fit:cover;border-radius:50%" />
      <span style="display:flex;flex-direction:column;gap:6px">
        <h2 style="font:700 18px 'Public Sans',sans-serif;margin:0">Built by the man who answers the phone.</h2>
        <p style="font:400 13.5px/1.6 'Public Sans',sans-serif;color:var(--tx2);max-width:80ch;margin:0">Bill Peiman has designed and built every Tulip board for 40 years — a pioneer of CNC memory upgrades. A customer on a machinist forum put it best: "We bought a memory expansion board from them in 1990. It's still working fine."</p>
        <span style="font:700 13px 'Public Sans',sans-serif;color:var(--acc)">Read the Tulip story →</span>
      </span>
    </a>
  </section>

  <!-- CTA -->
  <section class="container" style="padding-bottom:48px">
    <div style="padding:32px 36px;background:var(--ctaBg);border:1px solid var(--accLine);border-radius:12px;display:flex;align-items:center;justify-content:space-between;gap:28px;flex-wrap:wrap">
      <div>
        <h2 style="font:700 22px 'Public Sans',sans-serif;color:var(--ctaTx);margin:0 0 6px">Tell us your control. We'll confirm the fit and price.</h2>
        <p style="font:400 14px 'Public Sans',sans-serif;color:var(--ctaSub);margin:0">Prefer to talk? {contact.phone} — we like to talk shop.</p>
      </div>
      <a href="/quote/" class="btn" style="white-space:nowrap">Request a quote</a>
    </div>
  </section>
</Base>
